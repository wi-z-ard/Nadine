{{!
    @template core/loading

    Loading animation.

    The theme replaces core's Font Awesome sprite with a single ring painted
    from the active palette, so the spinner follows the selected colour theme
    (and the surrounding text colour inside buttons). The label stays in the
    accessibility tree for screen readers.

    Context variables required for this template:
    * overlay - Whether the icon is used as a full-area overlay.

    Example context (json):
    {
        "overlay": false
    }
}}
<span class="loading-icon icon-no-margin{{#overlay}} overlay{{/overlay}}">
    <span class="nl-spinner" aria-hidden="true"></span>
    <span class="visually-hidden">{{#str}} loading {{/str}}</span>
</span>
