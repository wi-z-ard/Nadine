{{!
    @template theme_nadine/profile_meta

    The quiet row of facts under the name on a public profile, with the edit
    action on the far side. Every chip is read from the user record and filtered
    against the site's hidden profile fields, so nothing appears here that the
    profile tree below does not show.

    Example context (json):
    {
        "hasmeta": true,
        "haschips": true,
        "chips": [
            {"icon": "<svg></svg>", "label": "Learning Design · Nadine Academy"},
            {"icon": "<svg></svg>", "label": "London, United Kingdom"},
            {"icon": "<svg></svg>", "label": "Member since October 2026"}
        ],
        "editurl": "/user/edit.php?id=5&returnto=profile",
        "editlabel": "Edit profile",
        "editicon": "<svg></svg>"
    }
}}
{{#hasmeta}}
    <div class="nl-profile__foot">
        {{#haschips}}
            <ul class="nl-profile__meta">
                {{#chips}}
                    <li class="nl-profile__chip">
                        {{{ icon }}}
                        <span>{{label}}</span>
                    </li>
                {{/chips}}
            </ul>
        {{/haschips}}
        {{#editurl}}
            <a class="nl-profile__action" href="{{editurl}}">
                {{{ editicon }}}
                <span>{{editlabel}}</span>
            </a>
        {{/editurl}}
    </div>
{{/hasmeta}}
