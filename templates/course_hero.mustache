{{!
    @template theme_nadine/course_hero

    Course header band. Replaces the stock page header on course home pages,
    which is why it carries the page's only h1.

    Example context (json):
    {
        "fullname": "Designing Learning Experiences",
        "category": "Category 1",
        "categoryurl": "/course/index.php?categoryid=1",
        "hascategory": true,
        "summary": "<p>Design learning that respects attention.</p>",
        "hassummary": true,
        "sections": "9 sections",
        "activities": "18 activities",
        "teachers": [{"name": "Maya Hassan"}],
        "hasteachers": true,
        "hasprogress": true,
        "progress": 42,
        "progresslabel": "of the course complete",
        "ctaurl": "/mod/page/view.php?id=2",
        "ctalabel": "Continue learning",
        "nextname": "How this course works",
        "nextlabel": "Up next"
    }
}}
<header class="nl-course-hero" aria-labelledby="nl-course-title">
    <div class="nl-course-hero__inner">
        <div class="nl-course-hero__copy">
            {{#hascategory}}
                <a class="nl-eyebrow nl-course-hero__category" href="{{categoryurl}}">{{category}}</a>
            {{/hascategory}}
            <h1 id="nl-course-title" class="nl-course-hero__title">{{fullname}}</h1>
            {{#hassummary}}
                <div class="nl-course-hero__summary">{{{summary}}}</div>
            {{/hassummary}}
            <ul class="nl-course-hero__meta">
                <li>
                    {{{ sectionsicon }}}
                    <span>{{sections}}</span>
                </li>
                <li>
                    {{{ activitiesicon }}}
                    <span>{{activities}}</span>
                </li>
                {{#hasteachers}}
                    <li>
                        {{{ teachersicon }}}
                        <span>{{teachernames}}</span>
                    </li>
                {{/hasteachers}}
            </ul>
        </div>

        <aside class="nl-course-hero__panel" aria-label="{{progresslabel}}">
            {{#hasprogress}}
                <div class="nl-progress">
                    <div class="nl-progress__ring" style="--nl-progress: {{progress}};">
                        <span class="nl-progress__value">{{progress}}<small>%</small></span>
                    </div>
                    <p class="nl-progress__label">{{progresslabel}}</p>
                </div>
            {{/hasprogress}}
            {{^hasprogress}}
                <p class="nl-course-hero__eyebrow">{{#str}}course_hero_overview, theme_nadine{{/str}}</p>
            {{/hasprogress}}

            <a class="btn btn-primary btn-lg nl-course-hero__cta" href="{{ctaurl}}">
                {{ctalabel}}
                {{{ ctaicon }}}
            </a>

            {{#nextname}}
                <p class="nl-course-hero__next">
                    <span>{{nextlabel}}</span>
                    <strong>{{nextname}}</strong>
                </p>
            {{/nextname}}
        </aside>
    </div>
</header>
