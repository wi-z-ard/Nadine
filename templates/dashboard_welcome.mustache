{{!
    @template theme_nadine/dashboard_welcome

    A compact welcome band above the dashboard. It shows the signed-in user's
    real name and picture and links to real Moodle pages; the actual course
    content and blocks remain untouched below it.

    The right column answers "what do I do now?" with the single course the
    learner should pick up. When they have no courses at all it offers the
    catalogue instead, so the space is never an empty panel.

    Context variables required for this template:
    * greeting, intro, userpicture - Welcome copy and avatar
    * links - Quick links
    * nextcourse - Course card context, or null
    * browseurl, browselabel - Catalogue fallback
    * emptylabel - Explains the empty state
}}
<section class="nl-welcome" aria-labelledby="nl-welcome-title">
    <div class="nl-welcome__col">
        <div class="nl-welcome__main">
            <div class="nl-welcome__picture">{{{userpicture}}}</div>
            <div class="nl-welcome__copy">
                <p class="nl-eyebrow">{{eyebrow}}</p>
                <h2 id="nl-welcome-title" class="nl-welcome__title">{{greeting}}</h2>
                <div class="nl-welcome__intro">{{{intro}}}</div>
            </div>
        </div>
        <nav class="nl-quicklinks" aria-label="{{quicklinkstitle}}">
            <h3 class="visually-hidden">{{quicklinkstitle}}</h3>
            {{#links}}
                <a class="nl-quicklink" href="{{url}}">
                    {{{ icon }}}
                    <span>{{label}}</span>
                </a>
            {{/links}}
        </nav>
    </div>
    <aside class="nl-welcome__aside">
        {{#nextcourse}}
            <p class="nl-welcome__aside-label">{{label}}</p>
            <a class="nl-next" href="{{{ url }}}">
                <span class="nl-next__ring{{^hasprogress}} nl-next__ring--idle{{/hasprogress}}"{{#hasprogress}} style="--nl-progress: {{progress}};"{{/hasprogress}}>
                    {{#hasprogress}}
                        <span class="nl-next__value">{{percentshort}}</span>
                    {{/hasprogress}}
                    {{^hasprogress}}
                        <span class="nl-next__value">{{{ icon }}}</span>
                    {{/hasprogress}}
                </span>
                <span class="nl-next__copy">
                    <span class="nl-next__name">{{name}}</span>
                    {{#hascategory}}<span class="nl-next__meta">{{category}}</span>{{/hascategory}}
                </span>
                <span class="nl-next__cta">
                    {{cta}}
                    {{{ arrowicon }}}
                </span>
            </a>
        {{/nextcourse}}
        {{^nextcourse}}
            <p class="nl-welcome__aside-label">{{#str}}gettingstarted, theme_nadine{{/str}}</p>
            <p class="nl-welcome__aside-text">{{emptylabel}}</p>
            <a class="btn btn-primary nl-welcome__aside-cta" href="{{{ browseurl }}}">{{browselabel}}</a>
        {{/nextcourse}}
    </aside>
</section>
