{{!
    @template theme_nadine/frontpage_stats

    Homepage counters. Every figure is read from the database.

    Example context (json):
    {
        "stats": [
            {"value": "12", "rawvalue": 12, "label": "Courses", "icon": "fa-graduation-cap", "accent": "#2563eb"}
        ]
    }
}}
<section class="nl-stats" aria-label="{{label}}" data-nl-reveal="up">
    <dl class="nl-stats__inner">
        {{#stats}}
            <div class="nl-stat" style="--nl-stat-accent: {{accent}};">
                <span class="nl-stat__icon" aria-hidden="true">
                    {{{ icon }}}
                </span>
                <div class="nl-stat__body">
                    <dt class="nl-stat__label">{{label}}</dt>
                    <dd class="nl-stat__value" data-nl-counter="{{rawvalue}}">{{value}}</dd>
                </div>
            </div>
        {{/stats}}
    </dl>
</section>
