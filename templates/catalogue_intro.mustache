{{!
    @template theme_nadine/catalogue_intro

    Course discovery band shown above Moodle's own course listing. The listing,
    categories, filters and pagination below it are still rendered by Moodle.
}}
<section class="nl-catalogue" aria-labelledby="nl-catalogue-title">
    <div class="nl-catalogue__copy">
        <p class="nl-eyebrow">{{eyebrow}}</p>
        <h2 id="nl-catalogue-title" class="nl-catalogue__title">{{title}}</h2>
        <div class="nl-catalogue__intro">{{{intro}}}</div>
    </div>

    {{#search}}{{> theme_nadine/search_form }}{{/search}}

    <div class="nl-catalogue__footer">
        {{#hascategories}}
            <div class="nl-catalogue__categories">
                <span class="nl-catalogue__label">{{categorieslabel}}</span>
                <ul class="nl-chips">
                    {{#categories}}
                        <li><a class="nl-chip" href="{{url}}">{{name}}</a></li>
                    {{/categories}}
                </ul>
            </div>
        {{/hascategories}}
        <a class="nl-textlink" href="{{allcoursesurl}}">
            {{allcourseslabel}}
            {{{ arrowicon }}}
        </a>
    </div>
</section>
