{{!
    @template theme_nadine/hero

    Public homepage hero.

    All links point at real Moodle pages. No course, learner or enrolment data
    is invented here.

    Example context (json):
    {
        "eyebrow": "A calmer way to learn",
        "title": "Learning that moves with you",
        "text": "<p>Structured courses, thoughtful feedback.</p>",
        "primaryurl": "/course/index.php",
        "primarylabel": "Browse courses",
        "secondaryurl": "/login/index.php",
        "secondarylabel": "Sign in",
        "showsearch": true,
        "searchaction": "/course/search.php",
        "searchlabel": "Search courses",
        "searchplaceholder": "Search courses",
        "points": [{"icon": "fa-graduation-cap", "label": "Curated programmes"}]
    }
}}
<section class="nl-hero" aria-labelledby="nl-hero-title">
    <div class="nl-hero__inner">
        <div class="nl-hero__copy">
            <p class="nl-eyebrow">{{eyebrow}}</p>
            <h1 id="nl-hero-title" class="nl-hero__title">{{title}}</h1>
            <div class="nl-hero__text">{{{text}}}</div>
            {{#welcome}}
                <p class="nl-hero__welcome">{{welcome}}</p>
            {{/welcome}}

            {{#showsearch}}
                {{#search}}{{> theme_nadine/search_form }}{{/search}}
            {{/showsearch}}

            <div class="nl-hero__actions">
                <a class="btn btn-primary btn-lg" href="{{primaryurl}}">
                    {{primarylabel}}
                    {{{ ctaicon }}}
                </a>
                <a class="btn btn-outline-secondary btn-lg" href="{{secondaryurl}}">{{secondarylabel}}</a>
                {{#signupurl}}
                    <a class="nl-hero__signup" href="{{signupurl}}">{{signuplabel}}</a>
                {{/signupurl}}
            </div>

            <ul class="nl-hero__points">
                {{#points}}
                    <li>
                        {{{ icon }}}
                        <span>{{label}}</span>
                    </li>
                {{/points}}
            </ul>
        </div>

        <div class="nl-hero__art">
            {{#hasimage}}
                <img class="nl-hero__image" src="{{imageurl}}" alt="{{imagealt}}">
            {{/hasimage}}
            {{^hasimage}}
                <div class="nl-hero__panel">
                    <p class="nl-hero__panel-kicker">{{arttitle}}</p>
                    <p class="nl-hero__panel-text">{{arttext}}</p>
                    <ol class="nl-hero__steps">
                        {{#artsteps}}
                            <li>
                                <span class="nl-hero__step-icon">
                                    {{{ icon }}}
                                </span>
                                <span class="nl-hero__step-copy">
                                    <strong>{{title}}</strong>
                                    <span>{{text}}</span>
                                </span>
                            </li>
                        {{/artsteps}}
                    </ol>
                </div>
            {{/hasimage}}
        </div>
    </div>
</section>
