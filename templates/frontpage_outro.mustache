{{!
    @template theme_nadine/frontpage_outro

    Homepage feature grid and closing call to action.

    Example context (json):
    {
        "eyebrow": "Why learn with us",
        "title": "Built for serious learning",
        "features": [
            {"icon": "fa-layer-group", "title": "Structured programmes", "text": "Clear outcomes."}
        ],
        "ctatitle": "Ready when you are",
        "ctatext": "Browse the catalogue.",
        "browseurl": "/course/index.php",
        "browselabel": "Browse the catalogue"
    }
}}
<section class="nl-features" aria-labelledby="nl-features-title">
    <div class="nl-features__head" data-nl-reveal="up">
        <p class="nl-eyebrow">{{eyebrow}}</p>
        <h2 id="nl-features-title" class="nl-features__title">{{title}}</h2>
    </div>
    <div class="nl-features__grid">
        {{#features}}
            <article class="nl-feature" data-nl-reveal="up">
                <span class="nl-feature__icon">{{{ icon }}}</span>
                <h3 class="nl-feature__title">{{title}}</h3>
                <p class="nl-feature__text">{{text}}</p>
            </article>
        {{/features}}
    </div>
</section>
<section class="nl-cta" aria-labelledby="nl-cta-title">
    <div class="nl-cta__inner" data-nl-reveal="up">
        <div class="nl-cta__copy">
            <h2 id="nl-cta-title" class="nl-cta__title">{{ctatitle}}</h2>
            <p class="nl-cta__text">{{ctatext}}</p>
        </div>
        <div class="nl-cta__actions">
            <a class="btn btn-primary btn-lg" href="{{browseurl}}">{{browselabel}}</a>
            {{#joinurl}}
                <a class="btn btn-outline-light btn-lg" href="{{joinurl}}">{{joinlabel}}</a>
            {{/joinurl}}
        </div>
    </div>
</section>
