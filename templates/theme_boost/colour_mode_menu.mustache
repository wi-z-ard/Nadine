{{!
    @template theme_nadine/theme_boost/colour_mode_menu

    The appearance control as a three-segment switch instead of a dropdown. Each
    segment is one of core's own `set-colourmode` options, so the existing
    `theme_boost/colourmode` module drives it unchanged: it reads
    `data-colourmode` and `data-action` and updates `aria-checked` on click.

    The current icon and label stay in the markup because that module writes to
    them; they are wrapped so the class swap cannot make them visible.

    Example context (json):
    {
        "cookieattributes": "; Max-Age=31536000; Path=/",
        "currenticon": "fa-sun",
        "currenttogglelabel": "Colour mode: Light",
        "modes": [
            {"mode": "light", "label": "Light", "icon": "fa-sun", "togglelabel": "Colour mode: Light", "isactive": true},
            {"mode": "dark", "label": "Dark", "icon": "fa-moon", "togglelabel": "Colour mode: Dark", "isactive": false},
            {"mode": "auto", "label": "System", "icon": "fa-circle-half-stroke", "togglelabel": "Colour mode: System", "isactive": false}
        ]
    }
}}
<div class="colourmodemenu" data-region="colourmode-menu" data-cookieattributes="{{cookieattributes}}">
    <div class="nl-colourmode" role="radiogroup" aria-label="{{#str}}colourmode, theme_nadine{{/str}}">
        {{#modes}}
            <button type="button"
                    class="nl-colourmode__option"
                    data-action="set-colourmode"
                    data-colourmode="{{mode}}"
                    data-icon="{{icon}}"
                    data-togglelabel="{{togglelabel}}"
                    role="radio"
                    aria-checked="{{#isactive}}true{{/isactive}}{{^isactive}}false{{/isactive}}"
                    aria-label="{{label}}"
                    title="{{label}}">
                <span class="nl-colourmode__glyph" aria-hidden="true"></span>
            </button>
        {{/modes}}
    </div>
    <span class="visually-hidden">
        <i class="icon fa {{currenticon}} fa-fw m-0" aria-hidden="true" data-region="colourmode-current-icon"></i>
        <span data-region="colourmode-current-label">{{currenttogglelabel}}</span>
    </span>
</div>
{{#js}}
    require(['theme_boost/colourmode'], function(ColourMode) {
        ColourMode.init();
    });
{{/js}}
